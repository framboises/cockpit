<?xml version="1.0" encoding="utf-8"?>
<resources>

    <color name="fieldBackground">#0f172a</color>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- Meme fond que Field : aucun flash blanc au chargement ni autour des barres -->
        <item name="android:windowBackground">@color/fieldBackground</item>
        <item name="android:statusBarColor">@color/fieldBackground</item>
        <item name="android:navigationBarColor">@color/fieldBackground</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@color/fieldBackground</item>
        <item name="windowSplashScreenBackground">@color/fieldBackground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>